{
  "schema": "sim_review_matrix_v1",
  "dump_schema": "sim_run_dump_v2",
  "rows": [
    {
      "id": "dump.schema",
      "path": "schema",
      "op": "eq",
      "expect": "sim_run_dump_v2",
      "note": "Must be a sim dump, not a witness envelope."
    },
    {
      "id": "dump.grade",
      "path": "proof_grade",
      "op": "eq",
      "expect": "sim_dump"
    },
    {
      "id": "dump.not_green_field",
      "rule": "green_absent",
      "note": "Dump must not carry a green verdict. Scoring is this matrix."
    },
    {
      "id": "world.generated",
      "path": "flags.world_generated",
      "op": "eq",
      "expect": true
    },
    {
      "id": "world.tick",
      "path": "tick",
      "op": "gte",
      "expect": 8,
      "note": "World must have ticked past bootstrap."
    },
    {
      "id": "water.has_open",
      "path": "counts.water_open_cells",
      "op": "gt",
      "expect": 0
    },
    {
      "id": "rivers.not_web",
      "path": "frac.river",
      "op": "lt",
      "expect": 0.08,
      "note": "Rivers should be channels (~few percent), not a cell web."
    },
    {
      "id": "trees.on_land",
      "rule": "veg_not_only_water",
      "note": "Live veg cells exist and are not only the water class."
    },
    {
      "id": "fire.inst_tracks_heat",
      "rule": "inst_tracks_heat",
      "note": "If heat cells > 0, instance rows must be > 0. If heat is 0, inst may be 0."
    },
    {
      "id": "fire.sparks_not_bootstrap",
      "rule": "sparks_not_bootstrap",
      "note": "If sparks exist they must not come from overlay_bootstrap."
    },
    {
      "id": "fire.heat_seen",
      "path": "fire.heat_cells.max",
      "op": "gt",
      "expect": 0,
      "note": "Seeded fire produced heat at some point in the run."
    },
    {
      "id": "fire.ignited",
      "path": "fire.ignited_cells_cum",
      "op": "gt",
      "expect": 0,
      "note": "Cells actually burned (burning or burnt), not just heat."
    },
    {
      "id": "fire.spreads",
      "path": "fire.burning_cells.max",
      "op": "gt",
      "expect_path": "fire.burning_cells.first",
      "note": "Peak burning exceeds the first burning sample: fire spread beyond the seed."
    },
    {
      "id": "fire.burns_out",
      "path": "fire.burning_cells.last",
      "op": "lt",
      "expect_path": "fire.burning_cells.max",
      "note": "Burning ends below its peak: fire burns out."
    },
    {
      "id": "fire.leaves_burnt",
      "path": "fire.burnt_cells.max",
      "op": "gt",
      "expect": 0,
      "note": "Burn-out leaves burnt cells."
    },
    {
      "id": "fire.scar_holds",
      "path": "fire.burnt_fraction.last",
      "op": "gte",
      "expect_path": "fire.burnt_fraction.first",
      "note": "W2: burnt fraction must not drop within a playcheck (no instant regrow)."
    },
    {
      "id": "fire.wind_elongation",
      "path": "fire.length_breadth.max",
      "op": "gte",
      "expect": 1.0,
      "note": "W2: heat bbox length:breadth tracked (elongation under wind when fire+wind present)."
    },
    {
      "id": "construction.sites_exist",
      "path": "construction.sites_total",
      "op": "gte",
      "expect": 1
    },
    {
      "id": "construction.operational",
      "path": "construction.sites_operational",
      "op": "gte",
      "expect": 1,
      "note": "At least one site reached Operational."
    },
    {
      "id": "construction.starter_hq",
      "path": "construction.hq_present",
      "op": "gte",
      "expect": 1,
      "note": "Starter HQ spawned."
    },
    {
      "id": "construction.all_hq",
      "path": "construction.hq_present",
      "op": "gte",
      "expect_path": "construction.hq_configured",
      "note": "Every configured faction has its HQ."
    },
    {
      "id": "economy.plants_exist",
      "path": "economy.plants_total",
      "op": "gte",
      "expect": 1
    },
    {
      "id": "economy.plant_operational",
      "path": "economy.plants_operational",
      "op": "gte",
      "expect": 1,
      "note": "At least one plant is producing (not idle, not starved)."
    },
    {
      "id": "economy.produced",
      "path": "economy.produced_total",
      "op": "gt",
      "expect": 0,
      "note": "Units actually produced."
    },
    {
      "id": "economy.not_all_starved",
      "path": "economy.plants_starved",
      "op": "lt",
      "expect_path": "economy.plants_total",
      "note": "Not every plant is starved."
    },
    {
      "id": "economy.storage_used",
      "path": "economy.storage_fill",
      "op": "gt",
      "expect": 0,
      "note": "Some output buffer holds product."
    },
    {
      "id": "logistics.orders",
      "path": "logistics.orders_total",
      "op": "gte",
      "expect": 1,
      "note": "Standing lines + one-off orders exist."
    },
    {
      "id": "logistics.standing_lines",
      "path": "logistics.standing_lines",
      "op": "gte",
      "expect": 1
    },
    {
      "id": "logistics.deliveries",
      "path": "logistics.deliveries_completed",
      "op": "gt",
      "expect": 0,
      "note": "Trucks completed deliveries."
    },
    {
      "id": "logistics.delivered_units",
      "path": "logistics.delivered_units",
      "op": "gt",
      "expect": 0
    },
    {
      "id": "logistics.unserved_draw",
      "path": "logistics.unserved_draw_demands",
      "op": "lte",
      "note": "No draw demand left without a serving line.",
      "expect": 0
    },
    {
      "id": "ai.roster",
      "rule": "ai_roster",
      "note": "At least one AI faction slot exists."
    },
    {
      "id": "ai.each_decided",
      "rule": "ai_each_decided",
      "note": "Every AI slot made >=1 decision."
    },
    {
      "id": "ai.each_issued_order",
      "rule": "ai_each_issued_order",
      "note": "Every AI slot issued >=1 order."
    },
    {
      "id": "combat.fronts",
      "path": "combat.front_segments",
      "op": "gte",
      "expect": 1
    },
    {
      "id": "combat.formations",
      "path": "combat.formations",
      "op": "gte",
      "expect": 1
    },
    {
      "id": "combat.engaged",
      "path": "combat.engaged_formations_series.max",
      "op": "gte",
      "expect": 1,
      "note": "A formation was engaged at some point."
    },
    {
      "id": "combat.orders_resolved",
      "path": "combat.deployment_orders_resolved_ok",
      "op": "gte",
      "expect": 1,
      "note": "A deployment order was executed."
    },
    {
      "id": "combat.territory_changed",
      "path": "combat.territory_change_cells",
      "op": "gt",
      "expect": 0,
      "note": "Control of some cells changed hands."
    },
    {
      "id": "weather.solved",
      "path": "weather.solves",
      "op": "gte",
      "expect": 2,
      "note": "Weather field solved at least twice (60 s game-time steps)."
    },
    {
      "id": "weather.systems",
      "path": "weather.systems.min",
      "op": "gte",
      "expect": 2,
      "note": "At least two pressure systems at every solve."
    },
    {
      "id": "weather.wind_varies_across_cells",
      "path": "weather.wind_speed_stddev_mps.max",
      "op": "gt",
      "expect": 0.3,
      "note": "Wind speed differs between weather cells (spatial stddev, m/s)."
    },
    {
      "id": "weather.wind_changes_over_time",
      "path": "weather.wind_change_mps.max",
      "op": "gt",
      "expect": 0.05,
      "note": "Mean per-cell wind vector change between consecutive solves (m/s)."
    },
    {
      "id": "weather.wind_peak_plausible",
      "path": "weather.max_wind_mps.max",
      "op": "lt",
      "expect": 30,
      "note": "Peak cell wind below 30 m/s (default seeded weather, no storm preset)."
    },
    {
      "id": "weather.rain_seen",
      "path": "weather.rain_coverage_pct.max",
      "op": "gt",
      "expect": 0,
      "note": "Some weather cell rained (>= 0.1 mm/h) at some point in the run."
    },
    {
      "id": "perf.sampled",
      "path": "perf.samples",
      "op": "gt",
      "expect": 0
    },
    {
      "id": "perf.release.avg_ms",
      "path": "perf.avg_ms",
      "op": "lte",
      "expect": 33,
      "when_build": ["release"],
      "note": "Release average frame <= 33 ms (30 fps)."
    },
    {
      "id": "perf.release.p95_ms",
      "path": "perf.p95_ms",
      "op": "lte",
      "expect": 50,
      "when_build": ["release"],
      "note": "Release p95 frame <= 50 ms."
    },
    {
      "id": "perf.release.hitches",
      "path": "perf.hitches",
      "op": "lte",
      "expect": 10,
      "when_build": ["release"],
      "note": "Release frames over the 50 ms hitch bar after warm-up (whole run)."
    },
    {
      "id": "perf.release.stalls",
      "path": "perf.stalls",
      "op": "lte",
      "expect": 0,
      "when_build": ["release"],
      "note": "Release frames over 1 s after warm-up."
    },
    {
      "id": "perf.debug.avg_ms",
      "path": "perf.avg_ms",
      "op": "lte",
      "expect": 22,
      "when_build": ["debug"],
      "note": "Debug average frame <= 22 ms (crate at opt-level 1; ~1.5x the measured 14 ms)."
    },
    {
      "id": "perf.debug.p95_ms",
      "path": "perf.p95_ms",
      "op": "lte",
      "expect": 32,
      "when_build": ["debug"],
      "note": "Debug p95 frame <= 32 ms (~1.5x the measured 20 ms)."
    },
    {
      "id": "perf.debug.hitches_per_min",
      "path": "perf.hitches_per_min",
      "op": "lte",
      "expect": 6,
      "when_build": ["debug"],
      "note": "Debug frames over the 500 ms hitch bar, per minute of frames."
    },
    {
      "id": "perf.debug.stalls",
      "path": "perf.stalls",
      "op": "lte",
      "expect": 1,
      "when_build": ["debug"],
      "note": "Debug frames over 1 s after warm-up."
    }
  ]
}