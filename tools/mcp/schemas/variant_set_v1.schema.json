{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-engine.local/schemas/variant_set_v1.json",
  "title": "VariantSetV1",
  "description": "USD-like variant composition for assembly tile bakes — declarative layers, not duplicate blend files",
  "type": "object",
  "required": ["schema_version", "variant_set_id", "assembly_id", "variants"],
  "properties": {
    "schema_version": { "const": 1 },
    "variant_set_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "assembly_id": { "type": "string", "minLength": 1 },
    "style_pack_id": { "type": "string" },
    "seed": { "type": "integer", "minimum": 0 },
    "axes": {
      "type": "object",
      "description": "Allowed values per axis for expansion / validation",
      "properties": {
        "state": { "type": "array", "items": { "enum": ["clean", "dirty", "damaged", "ruined"] } },
        "power": { "type": "array", "items": { "enum": ["off", "partial", "on"] } },
        "fill": { "type": "array", "items": { "enum": ["empty", "quarter", "half", "full"] } },
        "lighting": { "type": "array", "items": { "enum": ["day", "night_off", "night_on"] } }
      },
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["variant_key", "layers"],
        "properties": {
          "variant_key": { "type": "string", "minLength": 1 },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Manual or agent labels: stylepack_*, sim_*, agent_request_*, user_*"
          },
          "sim_tags": {
            "type": "array",
            "items": { "type": "string", "pattern": "^sim_" },
            "description": "PT-3 sim resolver tags (sim_night, sim_power_on, sim_fire, …)"
          },
          "layers": {
            "type": "object",
            "properties": {
              "base": { "type": "object", "additionalProperties": true },
              "material": { "type": "object", "additionalProperties": true },
              "lighting": {
                "type": "object",
                "properties": {
                  "lighting": { "type": "string" },
                  "power": { "type": "string" },
                  "night_lights": { "type": "boolean" },
                  "emissive_strength": { "type": "number", "minimum": 0, "maximum": 10 },
                  "color_temperature_k": { "type": "number" }
                },
                "additionalProperties": true
              },
              "damage": {
                "type": "object",
                "properties": {
                  "state": { "type": "string" },
                  "damage": { "type": "number", "minimum": 0, "maximum": 1 }
                },
                "additionalProperties": true
              },
              "fill": {
                "type": "object",
                "properties": {
                  "fill": { "type": "string" }
                },
                "additionalProperties": true
              },
              "sim": { "type": "object", "additionalProperties": true }
            },
            "additionalProperties": false
          },
          "bake": {
            "type": "object",
            "properties": {
              "status": { "enum": ["pending", "running", "done", "failed"] },
              "png": { "type": "string" },
              "last_job_id": { "type": "string" }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
