{
  "schema_version": 1,
  "grid_unit_m": 4.0,
  "floor_height_m": 3.0,
  "pivot_convention": "bottom_center",
  "edge_socket_names": ["left", "right", "top", "bottom"],
  "seam_tolerance_m": 0.01,
  "module_families": {
    "wall": {
      "height_m": 3.0,
      "width_grid_units": [1, 2, 3]
    },
    "door": {
      "target_wall_height_m": 3.0,
      "opening_height_m": 2.1,
      "frame_align_top_to_wall": true
    },
    "window": {
      "target_wall_height_m": 3.0,
      "sill_height_m": 0.9,
      "head_height_m": 2.4
    },
    "roof": {
      "seat_plane_export_min_y": 0.0,
      "notes": "Author height on Blender +Z; export_yup → glTF +Y. Seat underside min Y ≥ 0 (BQ-F1 / BUILDING-LOOK-V2-ART)."
    },
    "axis_convention": {
      "blender_height_axis": "Z",
      "gltf_height_axis": "Y",
      "export_yup": true,
      "notes": "Wall/door/window height must land on glTF +Y for Bevy upright. Legacy Blender-Y authorship laid walls flat."
    },
    "corner": {
      "height_m": 3.0
    },
    "prop": {
      "bottom_pivot_y_zero": true
    }
  }
}
