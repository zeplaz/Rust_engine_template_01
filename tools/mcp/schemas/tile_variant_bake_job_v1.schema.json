{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-engine.local/schemas/tile_variant_bake_job_v1.schema.json",
  "title": "tile_variant_bake_job_v1",
  "type": "object",
  "required": ["schema_version", "job_id", "operation", "variant", "render", "output"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "operation": { "const": "tile_variant_bake" },
    "mode": { "type": "string", "enum": ["assembly", "terrain"] },
    "assembly_blend": { "type": "string" },
    "terrain_base": {
      "type": "string",
      "enum": ["wood", "stone", "concrete", "dirt", "asphalt", "metal_plate"]
    },
    "light_blend": { "type": "string" },
    "variant": {
      "type": "object",
      "required": ["state", "damage", "power", "lighting"],
      "properties": {
        "variant_key": { "type": "string" },
        "state": {
          "type": "string",
          "enum": ["clean", "dirty", "damaged", "ruined"]
        },
        "damage": { "type": "number", "minimum": 0, "maximum": 1 },
        "power": { "type": "string", "enum": ["off", "partial", "on"] },
        "fill": {
          "type": "string",
          "enum": ["empty", "quarter", "half", "full"]
        },
        "lighting": {
          "type": "string",
          "enum": ["day", "night_off", "night_on"]
        }
      }
    },
    "render": {
      "type": "object",
      "required": ["method", "seed"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["blender_orthographic_iso", "blender_keyframe_light_rig"]
        },
        "seed": { "type": "integer" },
        "tile_size_px": { "type": "integer", "minimum": 32 },
        "camera_elevation_deg": { "type": "number" },
        "isometric": { "type": "boolean" }
      }
    },
    "output": {
      "type": "object",
      "required": ["png"],
      "properties": {
        "png": { "type": "string", "minLength": 1 }
      }
    }
  }
}
