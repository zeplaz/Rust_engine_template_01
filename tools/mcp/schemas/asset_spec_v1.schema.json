{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-engine.local/schemas/asset_spec_v1.json",
  "title": "AssetSpec",
  "type": "object",
  "required": ["schema_version", "asset_id", "archetype"],
  "properties": {
    "schema_version": { "const": 1 },
    "asset_id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]*$" },
    "archetype": {
      "type": "string",
      "enum": ["module_wall", "module_roof", "module_door", "module_window", "module_prop", "module_kit"]
    },
    "style_pack": { "type": "string" },
    "module": {
      "type": "object",
      "properties": {
        "grid_units": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2
        },
        "snap": { "type": "string" },
        "pivot": { "enum": ["bottom_center", "origin"] }
      }
    },
    "dimensions_m": {
      "type": "object",
      "properties": {
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "d": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "material_profile": { "type": "string" },
    "development_tier": { "type": "string", "enum": ["smoke", "lod0", "production"] },
    "pbr_status": { "type": "string", "enum": ["none", "deferred", "pending", "shipped"] },
    "batch_id": { "type": "string" },
    "module_id_alias_of": { "type": ["string", "null"] },
    "references": { "type": "array", "items": { "type": "string" } },
    "composition": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module_id": { "type": "string" },
          "grid": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 },
            "minItems": 2,
            "maxItems": 2
          },
          "count": { "type": "integer", "minimum": 1 },
          "zone": { "type": "string" },
          "placement": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["module_id", "grid"]
      }
    },
    "geometry_notes": { "type": "object" },
    "feeds": { "type": "string" },
    "utility_role": { "type": "string" },
    "power_tier": { "type": "string" },
    "plant_definition_id": { "type": "string" },
    "catalog_id_planned": { "type": "string" },
    "hero_module": {
      "type": "object",
      "properties": {
        "module_id": { "type": "string" },
        "grid": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "site_zones": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "module_whitelist": { "type": "array", "items": { "type": "string" } },
    "state_read": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "state": { "type": "string" },
          "visual": { "type": "string" }
        }
      }
    },
    "spec_only": { "type": "boolean" },
    "bpy_blocked": { "type": "boolean" }
  },
  "additionalProperties": false
}
