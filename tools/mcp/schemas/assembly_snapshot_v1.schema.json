{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-engine.local/schemas/assembly_snapshot_v1.schema.json",
  "title": "assembly_snapshot_v1",
  "type": "object",
  "required": [
    "schema_version",
    "assembly_id",
    "style_pack_id",
    "footprint",
    "module_placements",
    "seed"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": 1 },
    "assembly_id": { "type": "string", "minLength": 1 },
    "style_pack_id": { "type": "string", "pattern": "^style_[a-z][a-z0-9_]*$" },
    "source_tier": {
      "type": "string",
      "enum": ["lod0", "production"]
    },
    "procedural_rules_version": { "type": "string" },
    "reference_tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "seed": { "type": "integer" },
    "archetype_id": {
      "type": "string",
      "description": "BuildingGrammar archetype (e.g. industrial_warehouse)"
    },
    "district_style": {
      "type": "string",
      "description": "District / style pack selector for grammar.generate"
    },
    "grammar_rule_chain": {
      "type": "object",
      "description": "APS-GRAMMAR-INSPECTOR — evaluated rule ids",
      "properties": {
        "archetype": { "type": "string" },
        "massing": { "type": "string" },
        "roof": { "type": "string" },
        "facade": { "type": "string" },
        "detail": { "type": "string" },
        "age": { "type": "string" },
        "footprint_mode": { "type": "string" }
      },
      "additionalProperties": true
    },
    "footprint": {
      "type": "object",
      "required": ["width", "depth", "floors"],
      "properties": {
        "width": { "type": "integer", "minimum": 2 },
        "depth": { "type": "integer", "minimum": 2 },
        "floors": { "type": "integer", "minimum": 1 },
        "wdc_cell_count": { "type": "integer", "minimum": 1 }
      }
    },
    "module_placements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://rust-engine.local/schemas/assembly_graph_node_v1.schema.json"
      }
    }
  }
}
