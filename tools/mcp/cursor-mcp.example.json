{
  "mcpServers": {
    "rust-engine-art": {
      "command": "cmd",
      "args": [
        "/c",
        "tools/mcp/scripts/run_rust_engine_mcp.cmd"
      ],
      "env": {
        "RUST_ENGINE_REPO": "<repo>",
        "BLENDER_EXE": "blender",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1",
        "RUST_ENGINE_PYTHON": "python"
      }
    }
  }
}
