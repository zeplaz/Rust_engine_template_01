{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-engine.local/schemas/validation_report_v1.json",
  "title": "ValidationReport",
  "type": "object",
  "required": ["schema_version", "validator", "status", "compression_level"],
  "properties": {
    "schema_version": { "const": 1 },
    "validator": {
      "type": "string",
      "enum": [
        "cargo",
        "bevy",
        "mcp_schema",
        "asset_glb",
        "test",
        "tile",
        "blender"
      ]
    },
    "status": { "enum": ["passed", "failed", "warning"] },
    "compression_level": { "type": "integer", "minimum": 1, "maximum": 4 },
    "summary": { "type": "string" },
    "error_count": { "type": "integer", "minimum": 0 },
    "warning_count": { "type": "integer", "minimum": 0 },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation_issue" }
    },
    "known_fixes": {
      "type": "array",
      "items": { "$ref": "#/$defs/known_fix" }
    },
    "raw_log_path": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "$defs": {
    "validation_issue": {
      "type": "object",
      "required": ["kind", "severity"],
      "properties": {
        "kind": { "type": "string" },
        "severity": { "enum": ["error", "warning", "info"] },
        "file": { "type": "string" },
        "line": { "type": "integer" },
        "column": { "type": "integer" },
        "symbol": { "type": "string" },
        "field": { "type": "string" },
        "hint": { "type": "string" },
        "rustc_code": { "type": "string" },
        "api": { "type": "string" },
        "replacement": { "type": "string" },
        "signature": { "type": "string" }
      }
    },
    "known_fix": {
      "type": "object",
      "properties": {
        "signature": { "type": "string" },
        "fix": { "type": "string" },
        "confidence": { "type": "number" }
      }
    }
  }
}
