// PLAN-ROADS-v1 road tiers (src/construction/road_tier.rs). Speeds in km/h, capacity in vehicles
// per hour per lane, flood_close_m = water depth that closes the road, materials_per_m = the works
// bill per metre (cargo, units; taken from stock when the player builds). First pass; tune here.
(
    schema_version: 1,
    // Cross-country truck speed on open dry ground; the RD-2 off-road field scales it per tile
    // (land + slope from the `wheeled_logistics` mobility profile, then the tuning below).
    offroad_speed_kmh: 18.0,
    offroad: (
        ford_max_m: 0.5,        // deeper water is a wall off-road
        wet_m: 0.05,            // shallower is just wet ground
        ford_mul: 0.35,         // fording shallow water
        rubble_mul: 0.3,        // rubble / crater tiles
        mud_from_moisture: 0.6, // soil moisture where mud starts
        mud_slow: 0.6,          // speed lost in full mud
        snow_slow: 0.5,         // speed lost under full snow
    ),
    // RD-5 worn tracks: passes a tile needs, fade half-life (sim s), shortest run that becomes a
    // Track road, and the wear a moving formation leaves per second by class.
    worn_tracks: (
        passes_to_form: 30.0,
        half_life_s: 3600.0,
        min_run_tiles: 6,
        infantry_per_s: 0.05,
        light_per_s: 0.2,
        wheeled_per_s: 0.5,
        tracked_per_s: 1.5,
    ),
    // RD-7 rail freight: line and siding speed, wagon load, how far a yard reaches for the line,
    // and the shortest haul (straight-line tiles) worth sending by rail.
    rail: (
        speed_kmh: 80.0,
        siding_kmh: 15.0,
        wagon_capacity: 50,
        yard_reach_tiles: 10.0,
        intermodal_min_tiles: 60.0,
    ),
    // Railway bill per metre: ballast, rails, sleepers.
    rail_materials_per_m: [("Gravel", 1.0), ("Steel", 0.25), ("Timber", 0.3)],
    tiers: [
        (tier: Track,    speed_kmh: 25.0,  lanes_default: 1, capacity_veh_h_lane: 40.0,  wet_speed_mul: 0.4,  flood_close_m: 0.3,
         materials_per_m: []),
        (tier: Dirt,     speed_kmh: 35.0,  lanes_default: 1, capacity_veh_h_lane: 60.0,  wet_speed_mul: 0.5,  flood_close_m: 0.3,
         materials_per_m: [("Fuel", 0.02)]),
        (tier: Gravel,   speed_kmh: 55.0,  lanes_default: 2, capacity_veh_h_lane: 120.0, wet_speed_mul: 0.85, flood_close_m: 0.5,
         materials_per_m: [("Gravel", 0.6), ("Fuel", 0.03)]),
        (tier: Paved,    speed_kmh: 80.0,  lanes_default: 2, capacity_veh_h_lane: 300.0, wet_speed_mul: 1.0,  flood_close_m: 0.5,
         materials_per_m: [("Gravel", 0.8), ("Cement", 0.1), ("Fuel", 0.05)]),
        (tier: Concrete, speed_kmh: 90.0,  lanes_default: 2, capacity_veh_h_lane: 400.0, wet_speed_mul: 1.0,  flood_close_m: 0.6,
         materials_per_m: [("Gravel", 0.6), ("Concrete", 1.2), ("Steel", 0.05)]),
        (tier: Motorway, speed_kmh: 110.0, lanes_default: 4, capacity_veh_h_lane: 900.0, wet_speed_mul: 1.0,  flood_close_m: 0.8,
         materials_per_m: [("Gravel", 1.5), ("Concrete", 2.5), ("Steel", 0.15), ("Fuel", 0.1)]),
    ],
)
