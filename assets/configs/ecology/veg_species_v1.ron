// Vegetation species + parametric crown shapes (VEG-SHAPE-001).
//
// One table drives BOTH presentation modes (TacticalFlat2D symbols, PixelWorld3D voxel trees):
//   cell biome / moisture / temperature  ->  species id per cell   (extract, cached per chunk)
//   species + maturity + site rand       ->  TreeShape             (pure, per instance)
//   TreeShape                            ->  2D crown symbol | stacked voxel tiers
//
// Species ids are the index in `species` (u8). Append only: reordering reshuffles every forest.
// Heights / widths are tile units for a mature (Old) tree; `maturity` scales Young and Shrub.
// Colours are the mature crown (`crown_old`), young crown, tier tip, and shrub tint.
(
    // Salt for the per-cell patch noise. Same table + same cell = same species.
    seed: 20261115,
    // Edge (tiles) of one mixed-stand patch. Larger = bigger single-species stands.
    patch_tiles: 12.0,
    maturity: (
        shrub: (width: 0.58, height: 0.24),
        young: (width: 0.72, height: 0.60),
        old: (width: 1.0, height: 1.0),
    ),
    species: [
        (
            id: "oak", flora: BroadleafTrees, profile: Round,
            biome: (marine: 0.0, coastal: 0.3, arid: 0.1, temperate: 1.0, boreal: 0.2, alpine: 0.0, wetland: 0.3),
            moisture: 0.55, temperature: 0.55, breadth: 0.8,
