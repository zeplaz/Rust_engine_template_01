            trunk_frac: 0.28, trunk_width: 0.16, taper: 0.45, tiers: 3,
            crown_old: (0.06, 0.24, 0.09), crown_young: (0.12, 0.36, 0.13),
            crown_tip: (0.09, 0.31, 0.12), crown_shrub: (0.34, 0.44, 0.17),
