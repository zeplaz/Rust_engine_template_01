                door_rhythm: "leg_offset",
                door_slot: "door_wide",
                placement_tags: ["loading_leg", "rail_adjacent"],
            ),
            (
                massing_id: "yard_complex",
                door_rhythm: "perimeter_only",
                placement_tags: ["yard_perimeter"],
            ),
        ],
    ),
    detail: (
