            (id: "weathered", weight: 50, variant_tags: ["clean", "weathered"], aps_mandate_tags: ["surface_weathered", "edge_wear"], condition_tags: ["aged"]),
            (id: "abandoned", weight: 20, variant_tags: ["abandoned", "damaged"], aps_mandate_tags: ["surface_abandoned", "vandalism", "surface_damaged", "structural_stress"], condition_tags: ["derelict", "damaged"]),
        ],
    ),
    district_styles: [
        (
            id: "manufacturing_row",
