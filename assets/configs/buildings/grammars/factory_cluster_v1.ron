(
    schema_version: 1,
    grammar_id: "factory_cluster_v1",
    archetype: (
        id: "FactoryCluster",
        usage: "factory",
        footprint_bounds: (
            min_width: 5,
            max_width: 14,
            min_depth: 4,
            max_depth: 10,
            min_floors: 1,
            max_floors: 2,
        ),
    ),
    massing: (
        strategies: [
            (id: "double_hall", weight: 40, width_depth_ratio: 1.35, footprint_mode: rect),
            (id: "long_hall", weight: 30, width_depth_ratio: 1.85, footprint_mode: rect),
            (id: "yard_complex", weight: 20, footprint_mode: yard_interior),
            (id: "l_shape", weight: 10, footprint_mode: l_shape),
            (id: "stepped_row", weight: 15, width_depth_ratio: 1.1, footprint_mode: rect),
            (id: "t_loading", weight: 10, footprint_mode: t_shape),
        ],
    ),
    roof: (
        default_slot: "roof_default",
        by_massing: [
            (massing_id: "double_hall", slot: "roof_industrial"),
            (massing_id: "yard_complex", slot: "roof_flat"),
            (massing_id: "stepped_row", slot: "roof_industrial"),
            (massing_id: "t_loading", slot: "roof_flat"),
        ],
    ),
    facade: (
        window_slot: "window_industrial",
        door_slot: "door_wide",
        wall_slot: "wall_1u",
        placement_tags: ["exterior", "industrial", "factory", "street_facing"],
        by_massing: [
            (
                massing_id: "double_hall",
                door_rhythm: "loading_bay",
                placement_tags: ["loading_dock", "factory"],
            ),
            (
                massing_id: "long_hall",
