// PLAN-FRONT-COMBAT-v1 balance table (fleet `front`). Metric units: metres, seconds, kilograms.
// Loaded by `src/combat/balance.rs`; compiled-in copy is the default, this file overrides at runtime.
// Validation: `FrontBalance::validate()`; tests: `cargo test -p proc_A_dine01 --lib combat::balance`.
(
    schema_version: 1,
    table_id: "front_balance_v1",
    tile_size_m: 25.0,
    front: (
        // A slot owns a cell when its control is at least this and it is the strongest slot.
        own_min: 0.25,
        // Two hostile slots both >= own_min and closer than this are "contested".
        contest_band: 0.3,
        // Cell-level derivation cadence in sim ticks (chunk-level contested list runs every frame).
        derive_every_ticks: 10,
    ),
    control: (
        // Overlay faction_control half-life when nothing re-stamps it (seconds of sim time).
        half_life_s: 120.0,
        // Relaxation cadence and sub-step bound (sim seconds).
        relax_step_s: 0.5,
        relax_max_substep_s: 2.0,
        // Control gained per second at full presence + full supply (a Zone{Control} centre).
        stamp_gain_per_s: 0.03,
        // Control lost per second per unit of adjacent/co-located hostile control.
        pressure_per_s: 0.12,
        // Spill of control into lower same-slot neighbours (how an advance creeps forward).
        spread_per_s: 0.006,
        // Fraction of gain/spill kept at zero supply.
        supply_floor: 0.3,
    ),
    theater: (
        max_len_m: 2000.0,
        depth_m: 500.0,
        id_keep_overlap: 0.3,
    ),
    pressure: (
        w_threat: 1.0,
        w_artillery: 0.8,
        w_contest: 0.6,
        w_supply: 0.5,
        w_mobility: 0.4,
        w_fortification: 0.7,
        nms_radius_m: 250.0,
        top_k: 3,
    ),
    supply: (
        // Notional infantry-equivalent formations per km of front, for the demand a front publishes.
        garrison_per_km: 2.0,
        // Seconds of combat draw kept on hand, and the fraction at which to reorder.
        buffer_s: 900.0,
        reorder_fraction: 0.5,
    ),
    combat: (
        step_s: 1.0,
        // Fraction of target strength removed per second by a full-strength, effectiveness-1 attacker.
        k_attrition: 0.002,
        morale_loss_per_strength: 1.5,
        morale_recovery_per_s: 0.002,
        break_threshold: 0.25,
        rally_threshold: 0.5,
        supply_burn_per_s: 0.0005,
        min_supply_factor: 0.2,
        min_morale_factor: 0.4,
        attack_mult: 1.2,
        defend_mult: 1.0,
        retreat_mult: 0.3,
        // Attacker exposure: an attacking formation does not benefit from fortification cover.
        attacker_cover_scale: 0.0,
        // Fraction of combat draw a formation not in contact still pulls.
        idle_draw_fraction: 0.35,
        // Supply regained per second while the front's delivered stock covers it; extra burn in contact.
        supply_recover_per_s: 0.01,
        engaged_burn_mult: 3.0,
        // Morale lost per second per unit of missing supply while in contact.
        morale_loss_unsupplied_per_s: 0.002,
        // Fall-back distance of a broken formation (tiles); movement slowdown per unit mobility cost.
        retreat_tiles: 10.0,
        mobility_slow_k: 1.0,
        // Artillery Zone{Fire} radius as a fraction of range; strength at or below which a formation dies.
        fire_zone_range_fraction: 0.15,
        destroyed_strength: 0.02,
        // Dig-in speed vs the trench build effort; engineers dig faster.
        dig_in_rate_mult: 10.0,
        engineer_dig_mult: 3.0,
        // Fortify order: how far behind the front rows are planned, and the most rows per order.
        fortify_setback_m: 100.0,
        fortify_max_rows: 8,
    ),
    units: [
        (kind: Infantry,    firepower: 1.0, range_m: 400.0,  control_radius_m: 300.0, speed_mps: 1.2,  toe_personnel: 600,
         draw_kg_per_s: (ammunition: 0.020, fuel: 0.002, rations: 0.012, engineering: 0.002)),
        (kind: Mechanized,  firepower: 1.4, range_m: 800.0,  control_radius_m: 400.0, speed_mps: 6.0,  toe_personnel: 550,
         draw_kg_per_s: (ammunition: 0.035, fuel: 0.060, rations: 0.011, engineering: 0.003)),
        (kind: Armor,       firepower: 2.2, range_m: 1500.0, control_radius_m: 400.0, speed_mps: 7.0,  toe_personnel: 300,
         draw_kg_per_s: (ammunition: 0.060, fuel: 0.120, rations: 0.006, engineering: 0.004)),
        (kind: Artillery,   firepower: 2.6, range_m: 6000.0, control_radius_m: 150.0, speed_mps: 4.0,  toe_personnel: 400,
         draw_kg_per_s: (ammunition: 0.150, fuel: 0.030, rations: 0.008, engineering: 0.002)),
        (kind: Recon,       firepower: 0.4, range_m: 600.0,  control_radius_m: 250.0, speed_mps: 9.0,  toe_personnel: 120,
         draw_kg_per_s: (ammunition: 0.005, fuel: 0.020, rations: 0.003, engineering: 0.001)),
        (kind: Engineer,    firepower: 0.5, range_m: 300.0,  control_radius_m: 200.0, speed_mps: 1.5,  toe_personnel: 350,
         draw_kg_per_s: (ammunition: 0.006, fuel: 0.010, rations: 0.007, engineering: 0.040)),
        (kind: AirDefense,  firepower: 0.6, range_m: 3000.0, control_radius_m: 100.0, speed_mps: 5.0,  toe_personnel: 200,
         draw_kg_per_s: (ammunition: 0.030, fuel: 0.015, rations: 0.004, engineering: 0.001)),
    ],
    // Attacker -> target multiplier. Missing pairs default to `effectiveness_default`.
    effectiveness_default: 1.0,
    effectiveness: [
        (attacker: Infantry,   target: Armor,      mult: 0.35),
        (attacker: Infantry,   target: Mechanized, mult: 0.6),
        (attacker: Infantry,   target: Infantry,   mult: 1.0),
        (attacker: Mechanized, target: Infantry,   mult: 1.2),
        (attacker: Mechanized, target: Armor,      mult: 0.6),
        (attacker: Armor,      target: Infantry,   mult: 1.6),
        (attacker: Armor,      target: Mechanized, mult: 1.4),
        (attacker: Armor,      target: Armor,      mult: 1.0),
        (attacker: Artillery,  target: Infantry,   mult: 1.3),
        (attacker: Artillery,  target: Armor,      mult: 0.5),
        (attacker: Artillery,  target: Artillery,  mult: 0.8),
        (attacker: Recon,      target: Armor,      mult: 0.2),
        (attacker: AirDefense, target: Armor,      mult: 0.3),
        (attacker: AirDefense, target: Infantry,   mult: 0.5),
    ],
    fortifications: [
        // cover: fraction of incoming attrition removed for the defender on that tile.
        // obstacle_slow: fraction of attacker movement speed removed when crossing.
        // anti_armor: extra cover against Armor / Mechanized attackers.
        (kind: Trench,      cover: 0.45, obstacle_slow: 0.2,  mobility_cost_add: 0.2,  anti_armor: 0.15, build_effort_person_hours: 600.0),
        (kind: Bunker,      cover: 0.7,  obstacle_slow: 0.1,  mobility_cost_add: 0.1,  anti_armor: 0.24, build_effort_person_hours: 2400.0),
        (kind: Wall,        cover: 0.35, obstacle_slow: 0.6,  mobility_cost_add: 0.5,  anti_armor: 0.25, build_effort_person_hours: 1500.0),
        (kind: DragonTeeth, cover: 0.05, obstacle_slow: 0.7,  mobility_cost_add: 0.6,  anti_armor: 0.5,  build_effort_person_hours: 900.0),
        (kind: Minefield,   cover: 0.0,  obstacle_slow: 0.5,  mobility_cost_add: 0.4,  anti_armor: 0.4,  build_effort_person_hours: 300.0),
        (kind: Wire,        cover: 0.05, obstacle_slow: 0.45, mobility_cost_add: 0.3,  anti_armor: 0.0,  build_effort_person_hours: 120.0),
    ],
)
