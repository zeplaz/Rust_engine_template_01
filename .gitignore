/target
/target_fleet*/
/target_*/
/.vscode

# Claude Code agent worktrees (isolated git checkouts; canonical tree is repo root on master)
/.claude/worktrees/

# Orchestrator volatile history (reports/runbooks are committed when refreshed)
/tools/orchestrator/history/run_*.json
/tools/orchestrator/state/last_run.json
/tools/orchestrator/target/
/tools/orchestrator/queues/HANDOFF.md

# Ephemeral Bevy trace_chrome / probe stdout (repo root)
/chrome_*.json
/chrome_*.log
/trace-*.json

# debug_runs — LOCAL ONLY. Proof/witness dumps must not enter git.
# Keep docs; everything else (JSON, PNG, logs, art_pipeline, caches) stays on disk.
/debug_runs/**
!/debug_runs/README.md
!/debug_runs/HOT.md

# Local archive of purged debug_runs piles (preview_jobs, validators, thumbs, …)
/_local_archive/

# Python bytecode (MCP toolchain)
**/__pycache__/
*.pyc