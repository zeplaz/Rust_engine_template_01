# Line-ending + binary policy (hygiene fleet, 2026-10-08).
#
# The index is stored LF. Agents and tools write LF, so the working tree is LF too
# (this silences the "LF will be replaced by CRLF" warnings that core.autocrlf=true produced).
# Windows-only shell scripts keep CRLF. Everything git cannot sniff as text stays binary.

* text=auto eol=lf

# Windows shells need CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Explicit text (never let heuristics flip these to binary).
*.rs    text diff=rust
*.toml  text
*.ron   text
*.wgsl  text
*.md    text diff=markdown
*.json  text
*.jsonl text
*.py    text diff=python
*.ps1   text
*.sh    text
*.yaml  text
*.yml   text

# Binary assets.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ktx2   binary
*.dds    binary
*.exr    binary
*.hdr    binary
*.glb    binary
*.gltf   text
*.blend  binary
*.blend1 binary
*.fbx    binary
*.ttf    binary
*.otf    binary
*.ogg    binary
*.wav    binary
*.mp3    binary
*.zip    binary
*.exe    binary
*.dll    binary
*.pdf    binary
